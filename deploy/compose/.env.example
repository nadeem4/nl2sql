# Copy to .env (git-ignored) and fill in. Never commit a real key.

# The model key for the provider in config/nl2sql.yaml.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Where the index, state, traces and results live: the nl2sql-data volume.
NL2SQL_DATA_DIR=/data

# demo | your_data | hosted. Overrides `mode:` in nl2sql.yaml.
NL2SQL_MODE=your_data
