# Copy to .env (git-ignored) and fill in. Never commit a real key.

# The model key for the provider in config/nl2sql.yaml.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# demo | your_data. Overrides `mode:` in nl2sql.yaml. (The public demo, `hosted`, is not for this stack:
# see docs/deployment/hosted-demo.md.)
NL2SQL_MODE=your_data
