{
  "version": 1,
  "roles": {
    "admin": {
      "description": "Every table in every demo database",
      "role": "admin",
      "allowed_datasources": [
        "*"
      ],
      "allowed_tables": [
        "*"
      ]
    },
    "analyst": {
      "description": "Everything except employee and support-agent records",
      "role": "analyst",
      "allowed_datasources": [
        "chinook",
        "support",
        "webanalytics"
      ],
      "allowed_tables": [
        "chinook.Album",
        "chinook.Artist",
        "chinook.Customer",
        "chinook.Genre",
        "chinook.Invoice",
        "chinook.InvoiceLine",
        "chinook.MediaType",
        "chinook.Playlist",
        "chinook.PlaylistTrack",
        "chinook.Track",
        "support.customers",
        "support.ticket_messages",
        "support.tickets",
        "webanalytics.conversions",
        "webanalytics.devices",
        "webanalytics.page_views",
        "webanalytics.referrers",
        "webanalytics.sessions"
      ]
    },
    "viewer": {
      "description": "Music catalog and anonymous web traffic; no customers, sales or support",
      "role": "viewer",
      "allowed_datasources": [
        "chinook",
        "webanalytics"
      ],
      "allowed_tables": [
        "chinook.Album",
        "chinook.Artist",
        "chinook.Genre",
        "chinook.MediaType",
        "chinook.Playlist",
        "chinook.PlaylistTrack",
        "chinook.Track",
        "webanalytics.devices",
        "webanalytics.page_views",
        "webanalytics.referrers"
      ]
    }
  }
}