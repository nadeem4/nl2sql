# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Environment files
.env
.env.*

# Build artifacts
build/
dist/
*.egg-info/
/artifacts/
site/

# Virtual environments
.venv/
venv/

# SQLite databases (generated locally)
data/*.db
data/*.sqlite

# Generated data stores
chroma_db/
data/vector_store_demo/

# Folders made by `nl2sql demo` (the default `nl2sql-demo/` or any other
# `--dir` starting with nl2sql-demo). They can hold a real API key in .env.demo.
nl2sql-demo*/
/nl2sql-demo.json

# Git worktrees created for Claude Code agents
.claude/worktrees/

# Runtime output
logs/
last_reasoning.json

# Playground UI build dependencies (the built page itself is committed)
node_modules/

# Run traces (TRACE_MODE); `nl2sql trace show|replay` reads them
traces/
